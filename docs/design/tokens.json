{
  "$description": "Café Palanca — design tokens (DTCG). Espelha docs/design/tokens.css; em caso de dúvida, o CSS é a fonte de verdade.",
  "color": {
    "$type": "color",
    "espresso": { "$value": "#15100C", "$description": "Fundo da página" },
    "torra": { "$value": "#1F1813", "$description": "Superfície" },
    "cacau": { "$value": "#2C2119", "$description": "Superfície elevada, cartões" },
    "bronze": { "$value": "#4A3626", "$description": "Contornos decorativos" },
    "bronze-claro": { "$value": "#86705B", "$description": "Contornos de campos (≥3:1)" },
    "cobre": { "$value": "#C9854A", "$description": "Acento principal" },
    "cobre-claro": { "$value": "#DDA06A", "$description": "Hover, foco, texto de acento sobre escuro" },
    "cobre-pressionado": { "$value": "#B87640" },
    "cobre-escuro": { "$value": "#8A4F22", "$description": "Texto de acento sobre papel" },
    "creme": { "$value": "#EFE5D4", "$description": "Texto principal / papel" },
    "papel": { "$value": "#E2D4BD" },
    "latte": { "$value": "#B3A491", "$description": "Texto secundário" },
    "sucesso": { "$value": "#8FB07A" },
    "aviso": { "$value": "#E0B04F" },
    "erro": { "$value": "#E5806A" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Newsreader", "Iowan Old Style", "Georgia", "serif"] },
    "corpo": { "$type": "fontFamily", "$value": ["Instrument Sans", "Segoe UI", "system-ui", "sans-serif"] }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "base": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" },
    "xl": { "$value": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)" },
    "2xl": { "$value": "clamp(1.5rem, 1.3rem + 1vw, 2rem)" },
    "3xl": { "$value": "clamp(2rem, 1.6rem + 2vw, 3rem)" },
    "4xl": { "$value": "clamp(2.5rem, 1.8rem + 3.5vw, 4.5rem)" },
    "5xl": { "$value": "clamp(3rem, 2rem + 5vw, 6rem)" }
  },
  "radius": {
    "$type": "dimension",
    "campo": { "$value": "0.5rem" },
    "cartao": { "$value": "1rem" },
    "painel": { "$value": "1.75rem" },
    "chapa": { "$value": "999px" }
  },
  "space": {
    "$type": "dimension",
    "unit": { "$value": "0.25rem", "$description": "Base de 4px; usar múltiplos" }
  },
  "layout": {
    "$type": "dimension",
    "pagina": { "$value": "75rem" },
    "leitura": { "$value": "40rem" }
  },
  "shadow": {
    "cartao": { "$type": "shadow", "$value": [
      { "color": "rgba(239,229,212,0.04)", "offsetX": "0", "offsetY": "1px", "blur": "0", "spread": "0", "inset": true },
      { "color": "rgba(0,0,0,0.55)", "offsetX": "0", "offsetY": "12px", "blur": "32px", "spread": "-12px" }
    ] },
    "elevada": { "$type": "shadow", "$value": [
      { "color": "rgba(239,229,212,0.06)", "offsetX": "0", "offsetY": "1px", "blur": "0", "spread": "0", "inset": true },
      { "color": "rgba(0,0,0,0.7)", "offsetX": "0", "offsetY": "24px", "blur": "48px", "spread": "-16px" }
    ] }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "rapida": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "lenta": { "$value": "480ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "saida": { "$value": [0.22, 1, 0.36, 1] },
      "padrao": { "$value": [0.4, 0, 0.2, 1] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  }
}
